# Azure OpenAI Configuration
REACT_APP_API_KEY=your_azure_openai_api_key_here
REACT_APP_API_URL=https://your-resource.openai.azure.com/
REACT_APP_DEPLOYMENT_ID=gpt-4o

# Azure Speech Services
REACT_APP_SPEECH_KEY=your_azure_speech_key_here
REACT_APP_SPEECH_REGION=eastus

# Firebase Configuration (Required for user authentication)
# Get these values from Firebase Console > Project Settings > General > Your apps
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id

# Instructions for Firebase Setup:
# 1. Go to https://console.firebase.google.com/
# 2. Create a new project or select existing project
# 3. Enable Realtime Database (Build > Realtime Database)
# 4. Go to Project Settings > General > Your apps
# 5. Copy the Firebase configuration values above
# 6. Create "pulse-credentials" node in Realtime Database with user credentials
#
# Example Database Structure:
# pulse-credentials/
#   user1/
#     password: "password123"
#   user2/
#     password: "securepass456"
#   admin/
#     password: "adminpass789"
